# Local development only.
#
# In the deployed environment, AWS Amplify injects these as build-time
# environment variables (set by the CDK WebAppPattern construct), so you do not
# manage them by hand there.
#
# To run the app locally (`npm start`) against the deployed backend, copy this
# file to `.env.local` and fill in the values. See the "Local front-end
# development" section of the root README for how to obtain each value.

REACT_APP_COGNITO_AUTHORITY=
REACT_APP_USER_POOL_CLIENT_ID=
REACT_APP_COGNITO_DOMAIN=
REACT_APP_API_URL=
REACT_APP_API_KEY=
REACT_APP_WSS_URL=
